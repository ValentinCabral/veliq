{
  "name": "veliq",
  "version": "0.1.0-alpha.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "benchmark": "node --experimental-strip-types apps/cli/main.ts benchmark",
    "benchmark:multilingual": "python3 research/benchmarks/multilingual.py",
    "benchmark:selective": "python3 research/benchmarks/selective.py",
    "benchmark:harness": "python3 research/benchmarks/harness.py",
    "demo": "node --experimental-strip-types examples/demo.ts",
    "dashboard": "node --experimental-strip-types apps/cli/main.ts dashboard",
    "tui": "node --experimental-strip-types apps/cli/main.ts tui",
    "mcp": "node --experimental-strip-types apps/cli/main.ts mcp",
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "veliq": "./apps/cli/veliq.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "^6.0.3"
  }
}
